  <ItemGroup>
    <ProjectReference Include="..\IntegrationBus.Core\IntegrationBus.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
